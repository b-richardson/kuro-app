# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Database (direct connection)
VITE_DB_HOST=db.your-project-ref.supabase.co
VITE_DB_PORT=5432
VITE_DB_DATABASE=postgres
VITE_DB_USER=postgres
VITE_DB_PASSWORD=your-db-password
VITE_DB_SSL=true

# Stripe (publishable key only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
VITE_MONTHLY_PRICE_ID=price_your_monthly_id
VITE_ANNUAL_PRICE_ID=price_your_annual_id
VITE_CHECKOUT_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/your-checkout-function
